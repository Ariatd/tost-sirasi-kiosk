[Unit]
Description=Tost Sirasi backend (sunucu modu - SQLite + SSE, kart okuma yok)
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=KIOSK_HOST=0.0.0.0
Environment=KIOSK_PORT=8080
WorkingDirectory=/home/aryatabiyezahd/tost-kiosk-project/backend
ExecStart=/usr/bin/python3 -u /home/aryatabiyezahd/tost-kiosk-project/backend/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
