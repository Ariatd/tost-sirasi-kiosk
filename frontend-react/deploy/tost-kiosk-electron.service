[Unit]
Description=Tost Sirasi Client Mode (panel: seri okuyucu + uzak backend istemcisi)
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
# uzak backend'in (gelistiricinin kendi bilgisayari) agi hazir olsun diye
# kisa bir bekleme - health check GEREKLI DEGIL, TOST_BACKEND_URL yanlissa
# uygulama zaten kendi uyari ekranini gosterir.
ExecStartPre=/bin/sleep 3
# GNOME oturumunun GTK_MODULES=gail:atk-bridge ayari Electron'daki GTK
# kullanimiyla catisiyordu (GLib-GObject "no handler" hatasi) - bu
# uygulama icin erisilebilirlik koprusunu kapatiyoruz.
Environment=NO_AT_BRIDGE=1
# .deb ile kurulan gercek uygulama (/usr/bin/tost-kiosk-client ->
# update-alternatives ile /opt/TostKioskClient/tost-kiosk-client'a bagli).
# Eskiden burada run.sh + elle indirilen AppImage calistiriliyordu; artik
# tek dagitim yolu .deb (bkz. README "Client Mode masaustu paketi").
# Backend adresi ~/.config/tost-kiosk-client/config.env'den okunuyor.
# --disable-gpu: panelin GPU/compositor'unde tekrarlayan
# "GetVSyncParametersIfAvailable failed" uyarilarindan sonra SIGTRAP ile
# cokme gozlendi (mini PC entegre grafik + Wayland compositor uyumsuzlugu
# ihtimali) - donanim hizlandirmayi bu uygulama icin kapatinca gecti.
# Not: gercek cokme nedeni yukaridaki --disable-gpu ile giderildi; Restart=no
# (eskiden gecici bir "restart loop" onlemiydi) bu yuzden artik gereksiz VE
# tehlikeli - kiosk beklenmedik sekilde kapanirsa (elektrik kesintisi, tek
# seferlik cokme) ekran bir daha hic acilmadan oyle kalirdi. Tek instans
# kilidi (bkz. main.cjs) coklu pencere riskini zaten onlediginden guvenle
# always'e donduruldu.
ExecStart=/usr/bin/tost-kiosk-client --disable-gpu --disable-software-rasterizer
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
