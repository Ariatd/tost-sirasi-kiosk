[Unit]
Description=Tost Sirasi Client Mode (panel: seri okuyucu + uzak backend istemcisi)
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
# uzak backend'in (gelistiricinin kendi bilgisayari) agi hazir olsun diye
# kisa bir bekleme - health check GEREKLI DEGIL, TOST_BACKEND_URL yanlissa
# uygulama zaten kendi uyari ekranini gosterir.
ExecStartPre=/bin/sleep 3
ExecStart=%h/tost-kiosk-electron/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
